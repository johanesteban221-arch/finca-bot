{
  "name": "GDP · WF-03 Backup Diario",
  "nodes": [
    {
      "id": "cron",
      "name": "Schedule Diario 02:00",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [0, 300],
      "parameters": { "rule": { "interval": [{ "field": "days", "triggerAtHour": 2 }] } },
      "notes": "Runs every day at 02:00 (America/Bogota) for the nightly snapshot."
    },
    {
      "id": "snapshot",
      "name": "Leer Snapshot Completo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [240, 300],
      "onError": "continueRegularOutput",
      "retryOnFail": true,
      "maxTries": 3,
      "parameters": { "method": "GET", "url": "=https://SUPABASE_PROJECT.supabase.co/rest/v1/vw_respaldo_completo", "authentication": "predefinedCredentialType", "nodeCredentialType": "supabaseApi", "options": {} },
      "notes": "Reads the whole herd serialized as one JSON document."
    },
    {
      "id": "guardar",
      "name": "Guardar Respaldo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [480, 300],
      "retryOnFail": true,
      "maxTries": 3,
      "parameters": { "method": "POST", "url": "=https://SUPABASE_PROJECT.supabase.co/rest/v1/respaldos", "authentication": "predefinedCredentialType", "nodeCredentialType": "supabaseApi", "sendBody": true, "contentType": "json", "specifyBody": "json", "jsonBody": "={{ JSON.stringify({ data: $json.data, n_animales: $json.n_animales }) }}", "options": {} },
      "notes": "Stores the snapshot row in the respaldos table."
    }
  ],
  "connections": {
    "Schedule Diario 02:00": { "main": [[{ "node": "Leer Snapshot Completo", "type": "main", "index": 0 }]] },
    "Leer Snapshot Completo": { "main": [[{ "node": "Guardar Respaldo", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "timezone": "America/Bogota" }
}
