# Copy to .env.local (local dev) or set these as Environment vars in Easypanel.
# NEVER commit real values — .env.local is gitignored.

# Supabase
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...            # legacy service_role JWT — reads/writes of herd data
SUPABASE_ANON_KEY=eyJ...                    # anon/publishable key — ONLY for login (Supabase Auth)

# WhatsApp Cloud API (Meta) - app "Ganaderia"
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_TOKEN=EAA...                       # System User permanent token
WHATSAPP_VERIFY_TOKEN=choose-a-random-string  # must match the value set in Meta webhook

# Cron protection — n8n calls /api/cron/daily-alerts?secret=CRON_SECRET
CRON_SECRET=choose-a-random-string

# Dashboard access.
# Fase 2: the dashboard logs in with email + password (Supabase Auth). The Basic
# Auth below is the BOOTSTRAP door: it is what lets the owner create the first
# real user without being locked out. Turn it off (remove AUTH_LEGACY_BASIC)
# only AFTER logging in successfully with the new account — see db/04_auth_roles.sql §4.
AUTH_LEGACY_BASIC=1                         # 1 = Basic Auth still accepted, as 'dueno'
DASHBOARD_USER=johan
DASHBOARD_PASSWORD=choose-a-strong-password

# Anthropic Claude (only used later for owner free-text queries / smart alerts)
# ANTHROPIC_API_KEY=sk-ant-...
